# Tilik — single system environment contract.
#
# Copy to the repo-root .env, then fill in:   cp infra/.env.example ../.env
# NEVER commit a real .env (it is gitignored). Both apps and Prisma load this single root .env.
# Generate strong secrets with:   openssl rand -base64 32

# ─── Database (PostgreSQL) ──────────────────────────────────────────────
# Compose provisions the OWNER (migrate) role from POSTGRES_USER and a NON-OWNER app role (tilik_app)
# via postgres/init/01-app-role.sh. CRUD grants are applied post-migrate by `pnpm --filter @tilik/db db:grant`.
POSTGRES_USER=tilik_owner                 # schema owner; Prisma/Migrate connects as this (DDL + shadow DB)
POSTGRES_PASSWORD=change_me_owner_pw      # openssl rand -base64 24
APP_DB_PASSWORD=change_me_app_pw          # non-owner tilik_app password; openssl rand -base64 24

# Migrate/DDL connection (OWNER). @tilik/db reads this (prisma.config.ts).
DATABASE_URL="postgresql://tilik_owner:change_me_owner_pw@localhost:5432/tilik?schema=public"
# Runtime CRUD connection (NON-OWNER) used by the API + detector in Prompt 14. The append-only
# guarantee binds this role. (No runtime consumer yet — see the plan's acceptance notes.)
APP_DATABASE_URL="postgresql://tilik_app:change_me_app_pw@localhost:5432/tilik?schema=public"
# PROD: append &sslmode=verify-full with a PINNED CA to both URLs; and DISABLE Prisma query-level
# logging (it emits patientToken, amounts, and diagnoses into logs). Local owner has CREATEDB, so
# Prisma's shadow DB "just works"; managed PG that forbids CREATE DATABASE needs a SHADOW_DATABASE_URL
# (see README) — omitted here to keep the local contract lean.

# ─── Object storage (MinIO / S3) ───────────────────────────────────────
MINIO_ROOT_USER=tilik_minio               # avoid the well-known "minioadmin" default
MINIO_ROOT_PASSWORD=change_me_minio_pw    # openssl rand -base64 24
MINIO_ENDPOINT=http://localhost:9000      # S3 API endpoint apps talk to (PROD: https:// with cert verify)
MINIO_ACCESS_KEY=tilik_minio              # = MINIO_ROOT_USER in dev; PROD: a SCOPED service-account key, not root
MINIO_SECRET_KEY=change_me_minio_pw       # = MINIO_ROOT_PASSWORD in dev
MINIO_BUCKET=tilik-evidence               # default bucket (auto-created by minio-init)
# PROD hardening: scoped access key (GetObject/PutObject on tilik-evidence only, no admin/console);
# least-privilege bucket policy; TLS endpoint with verification; enable OBJECT-LOCK / VERSIONING (WORM)
# on tilik-evidence so evidence objects can't be silently overwritten/deleted (extends the DB
# append-only guarantee to object storage).

# ─── Security ───────────────────────────────────────────────────────────
# Identity tokenization (patientToken). This IS the key the build prompt calls "HMAC_SECRET".
# Min 32 random bytes:  openssl rand -base64 32 . Keep in a secret manager / KMS in prod; never store
# it in a DB row. Rotation is effectively one-way (deterministic pseudonym) — a new key re-pseudonymizes
# every patient and breaks cross-episode linkage; VERSION the key if you must rotate.
PATIENT_TOKEN_HMAC_KEY=change_me_32_random_bytes_minimum
JWT_SECRET=change_me_jwt_signing_secret   # API session/JWT signing (Prompt 05+). openssl rand -base64 32

# ─── LLM ────────────────────────────────────────────────────────────────
# Claude evidence-grounded case summaries (Prompt 12+). Egress point to a third party: never log it;
# only send pseudonymized, evidence-grounded content — no raw NIK/BPJS and no raw patientToken in prompts.
ANTHROPIC_API_KEY=sk-ant-...

# ─── App ────────────────────────────────────────────────────────────────
API_PORT=3001                             # NestJS API port
WEB_PORT=3000                             # Next.js dev server port
NEXT_PUBLIC_API_URL=http://localhost:3001 # browser-visible API base
# HARD RULE: only NEXT_PUBLIC_* vars reach the browser. NEVER prefix a secret with NEXT_PUBLIC_.
# The web process must receive a MINIMAL allow-list (NEXT_PUBLIC_* + non-secret app vars) — not the
# whole .env — so PATIENT_TOKEN_HMAC_KEY / JWT_SECRET / ANTHROPIC_API_KEY never enter a public build.
