# Tilik — single system environment contract.
#
# From the repo root, copy to .env and fill in:   cp infra/.env.example .env
# NEVER commit a real .env (it is gitignored). Both apps and Prisma load this single root .env.
# Generate strong secrets with:   openssl rand -base64 32

# ─── Database (PostgreSQL) ──────────────────────────────────────────────
# Compose provisions the OWNER (migrate) role from POSTGRES_USER and a NON-OWNER app role (tilik_app)
# via postgres/init/01-app-role.sh. CRUD grants are applied post-migrate by `pnpm --filter @tilik/db db:grant`.
# dotenv does not interpolate ${...}, so keep each password in sync with its connection URL below.
POSTGRES_USER=tilik_owner                 # schema owner; Prisma/Migrate connects as this (DDL + shadow DB)
POSTGRES_PASSWORD=change_me_owner_pw      # openssl rand -base64 24; must match the password in DATABASE_URL
APP_DB_PASSWORD=change_me_app_pw          # non-owner tilik_app password; must match APP_DATABASE_URL

# Migrate/DDL connection (OWNER). @tilik/db reads this (prisma.config.ts).
DATABASE_URL="postgresql://tilik_owner:change_me_owner_pw@localhost:5432/tilik?schema=public"
# Runtime CRUD connection (NON-OWNER) for the API + detector in Prompt 14 (no runtime consumer yet).
APP_DATABASE_URL="postgresql://tilik_app:change_me_app_pw@localhost:5432/tilik?schema=public"
# PROD (Prompt 14): append &sslmode=verify-full (+ pinned CA) to both URLs; disable Prisma query-level
# logging (it would log patientToken/amounts/diagnoses). Managed PG without CREATE DATABASE needs a
# SHADOW_DATABASE_URL for migrate; the local owner has CREATEDB, so the shadow DB just works.

# ─── Object storage (MinIO / S3) ───────────────────────────────────────
MINIO_ROOT_USER=tilik_minio               # avoid the well-known "minioadmin" default
MINIO_ROOT_PASSWORD=change_me_minio_pw    # openssl rand -base64 24
MINIO_ENDPOINT=http://localhost:9000      # S3 API endpoint apps talk to
MINIO_ACCESS_KEY=tilik_minio              # dev shortcut: equals MINIO_ROOT_USER (full admin)
MINIO_SECRET_KEY=change_me_minio_pw       # dev shortcut: equals MINIO_ROOT_PASSWORD
MINIO_BUCKET=tilik-evidence               # default bucket (auto-created by minio-init)
# PROD (Prompt 14): replace the root-cred shortcut with a SCOPED service-account key (Get/PutObject on
# tilik-evidence only); TLS endpoint with cert verification; OBJECT-LOCK/VERSIONING (WORM) on the bucket
# so evidence can't be silently overwritten/deleted (extends the DB append-only guarantee to storage).

# ─── Security ───────────────────────────────────────────────────────────
# Identity tokenization (patientToken). This IS the key the build prompt calls "HMAC_SECRET".
# Min 32 random bytes (openssl rand -base64 32). Rotation is effectively one-way — a new key
# re-pseudonymizes every patient and breaks cross-episode linkage.
# PROD (Prompt 14): store in a secret manager / KMS, never in a DB row; version the key to rotate.
PATIENT_TOKEN_HMAC_KEY=change_me_32_random_bytes_minimum
JWT_SECRET=change_me_jwt_signing_secret   # API session/JWT signing (Prompt 05+). openssl rand -base64 32

# ─── LLM ────────────────────────────────────────────────────────────────
# Claude evidence-grounded case summaries (Prompt 12+). Third-party egress: never log the key, and
# only send pseudonymized, evidence-grounded content — no raw NIK/BPJS, no raw patientToken in prompts.
ANTHROPIC_API_KEY=sk-ant-...

# ─── App ────────────────────────────────────────────────────────────────
API_PORT=3001                             # NestJS API port
WEB_PORT=3000                             # Next.js dev server port
NEXT_PUBLIC_API_URL=http://localhost:3001 # browser-visible API base
# HARD RULE: only NEXT_PUBLIC_* vars reach the browser — NEVER prefix a secret with NEXT_PUBLIC_, and
# start `web` with a minimal allow-list (not the whole .env) so the HMAC/JWT/Anthropic keys stay server-side.
