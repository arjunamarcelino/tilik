{
  "name": "@tilik/api",
  "version": "0.0.0",
  "private": true,
  "description": "Tilik NestJS API — trust-boundary skeleton: JWT auth, RBAC, audit, config, health (Prompt 05).",
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "import:seed": "node --import tsx src/scripts/import-seed.ts",
    "test:vectors": "node --import tsx test/tokenize.vectors.ts",
    "test:contract": "node --import tsx test/outbox.contract.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@tilik/db": "workspace:*",
    "@tilik/shared": "workspace:*",
    "canonicalize": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^18.0.9",
    "helmet": "^8.0.0",
    "minio": "^8.0.5",
    "nestjs-pino": "^4.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino-http": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
