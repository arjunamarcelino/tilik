# Dependencies
node_modules/

# Build output
dist/
.next/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example
# Convention (not enforced here): infra/postgres/init/*.sh reads credentials from the environment
# (APP_DB_PASSWORD), so no literal secret should ever be committed under infra/postgres/**.

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Synthetic data generator output bundle (Prompt 04) — regenerate with generate.py
data/synthetic/out/

# Prisma generated client (Prompt 02) — the prisma-client generator emits TS source under src/
packages/db/src/generated/
.prisma/

# MinIO / container data (Prompt 03+)
**/minio-data/
infra/**/data/

# Test / coverage
coverage/

# OS / editor
.DS_Store

# Deliverables & working docs — kept out of the code repo (by request)
docs/
