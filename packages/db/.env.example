# Local Postgres. Prompt 03 ships a Docker Compose; for standalone use point at your own instance.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tilik?schema=public"

# Only needed if the migration role cannot CREATE DATABASE for Prisma's shadow DB (e.g. managed PG).
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tilik_shadow?schema=public"

# Role model (provisioned in Prompt 03's compose): Prisma/Migrate connects as the schema OWNER
# (DDL + CREATE DATABASE for the shadow DB). The API and the Python detector connect as a NON-OWNER
# app role with only SELECT/INSERT/UPDATE/DELETE and `REVOKE CREATE ON SCHEMA public` — so the worker
# reads/writes rows but can never alter the schema (Prisma stays the sole migrator), and the
# append-only REVOKEs actually bind it (the owner can bypass triggers, a non-owner cannot).

# HMAC key for patient pseudonymization (patientToken). Keep in a secret manager / KMS in production —
# never commit a real key, and never store it in a database row. Minimum 32 random bytes.
PATIENT_TOKEN_HMAC_KEY="CHANGE_ME_32_RANDOM_BYTES_MINIMUM"

# Production: append &sslmode=verify-full (with a pinned CA) to DATABASE_URL and disable
# Prisma query-level logging (it would emit patientToken, amounts, and diagnoses).
