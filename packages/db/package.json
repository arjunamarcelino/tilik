{
  "name": "@tilik/db",
  "version": "0.0.0",
  "private": true,
  "description": "Tilik database package — Prisma schema, migrations, and the typed client re-exported for the API.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "prisma generate",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:grant": "prisma db execute --file ../../infra/postgres/grant-app.sql",
    "studio": "prisma studio",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tilik/shared": "workspace:*",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.9",
    "prisma": "^7.10.1",
    "typescript": "^5.6.0"
  }
}
